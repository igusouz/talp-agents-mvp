# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# Python virtual environments and packaging
.venv/
venv/
env/
ENV/
__pypackages__/
build/
dist/
*.egg-info/
.eggs/

# Coverage and test output
.coverage
.coverage.*
coverage.xml
htmlcov/

# Node / frontend output
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and local secrets
.env
.env.*
!.env.example

# Logs, runtime data, and local databases
**/logs/*
!**/logs/.gitkeep
*.log
*.jsonl
*.sqlite
*.sqlite3
*.db
**/storage/db/*
**/storage/logs/*
**/storage/audit/*
!**/storage/db/.gitkeep
!**/storage/logs/.gitkeep
!**/storage/audit/.gitkeep

# IDE and OS noise
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
