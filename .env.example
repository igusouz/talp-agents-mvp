# Shared LLM settings for TALP agents. Defaults to Gemini.
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_RETRIES=1
LLM_THINKING_BUDGET=0

# Gemini credentials
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# OpenRouter credentials
# OPENROUTER_API_KEY=
# OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=TALP Agents

# Optional agent-specific overrides
