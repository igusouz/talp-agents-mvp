# Shared LLM settings. Defaults to Gemini.
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60

# Gemini credentials
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# OpenRouter credentials
# OPENROUTER_API_KEY=
# OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=TALP Agents

# Optional overrides just for BDD Agent
# QA_LLM_PROVIDER=
# QA_LLM_MODEL=
# QA_LLM_BASE_URL=
# QA_LLM_API_KEY=
# QA_LLM_TEMPERATURE=
# QA_LLM_TIMEOUT_SECONDS=

# API settings
QA_APP_NAME=BDD QA Agent
QA_APP_VERSION=0.1.0
QA_API_PREFIX=/api/v1
QA_LOG_LEVEL=INFO
