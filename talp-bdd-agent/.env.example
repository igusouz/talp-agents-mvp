# Gemini (OpenAI-compatible endpoint) settings
QA_LLM_MODEL=gemini-2.5-flash
QA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Preferred centralized key used across agents
GOOGLE_API_KEY=
# Legacy Gemini alias, optional
# GEMINI_API_KEY=
# Optional override just for BDD Agent
# QA_LLM_API_KEY=
QA_LLM_TEMPERATURE=0.0

# API settings
QA_APP_NAME=BDD QA Agent
QA_APP_VERSION=0.1.0
QA_API_PREFIX=/api/v1
QA_LOG_LEVEL=INFO
