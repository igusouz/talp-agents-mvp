# Ambiente da aplicação
ENVIRONMENT=development
DEBUG=true

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=TALP Compliance Agent API
API_VERSION=0.1.0

# Banco de dados
DATABASE_URL=sqlite:///./storage/db/compliance_agent.db

# LangGraph / LangChain (para uso futuro)
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_TRACING_V2=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=./storage/logs/app.log

# Integração com outros agentes
INVEST_AGENT_URL=http://localhost:8001
BDD_AGENT_URL=http://localhost:8002

# Diretórios
DATA_DIR=./data
PROMPTS_DIR=./prompts
STORAGE_DIR=./storage
